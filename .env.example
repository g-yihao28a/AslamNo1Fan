# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# ---- API Gateway ----
GATEWAY_NAME=api_gateway
GATEWAY_PORT=8008

# ---- ML Engine ----
ML_ENGINE_NAME=ml_engine
ML_ENGINE_PORT=8010

# ---- Database (Postgres) ----
INTERNAL_DB_HOST=database
INTERNAL_DB_PORT=5432
INTERNAL_DB_NAME=telco_churn_db
INTERNAL_DB_USER=postgres
INTERNAL_DB_PASSWORD=postgrespassword

# Database app
DATABASE_NAME=database_app
DATABASE_PORT=8009

# ---- Dashboard (Streamlit) ----
DASHBOARD_NAME=dashboard
DASHBOARD_PORT=8501
